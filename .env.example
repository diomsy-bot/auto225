# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres@localhost:5432/auto225"
# URL publique du site (liens dans les emails, sitemap)
APP_URL="http://localhost:3000"
# Dossier de stockage des fichiers (médias publics et justificatifs privés séparés)
STORAGE_DIR="./storage"
# Envoi d'emails (laisser vide en développement : les emails sont affichés dans la console)
SMTP_URL=""
MAIL_FROM="AUTO225 <no-reply@auto225.com>"
# Email de l'équipe qui reçoit les notifications de nouvelles demandes
TEAM_EMAIL="contact@auto225.com"
# Compte administrateur créé par le seed
SEED_ADMIN_EMAIL="admin@auto225.com"
SEED_ADMIN_PASSWORD="ChangezMoi!2026"
# Production : domaine servi par Caddy (HTTPS automatique) et email Let's Encrypt
DOMAIN="auto225.com"
ACME_EMAIL="contact@auto225.com"
# Mot de passe PostgreSQL utilisé par docker-compose
POSTGRES_PASSWORD=""
